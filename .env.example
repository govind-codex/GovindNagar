# GitHub Personal Access Token (public_repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Projects CE Token
PROJECTS_CE_TOKEN=

# Google Analytics service-account JSON. Keep this server-only.
# The service account must have Viewer access to the GA4 property.
# Use either compact JSON or base64-encoded JSON (useful for CI/Vercel).
GA_SERVICE_ACCOUNT_KEY={"client_email":"portfolio-analytics@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"}

# GA4 web stream measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HWWFL0WNBG

# GA4 numeric PROPERTY ID from Admin > Property details.
# This is not the web stream ID and does not start with "G-".
GA_SITE_PROPERTY_ID=123456789
